{
	"name": "@prefig/upact-eudi",
	"version": "0.1.0",
	"description": "EUDI wallet relying-party adapter for upact — OpenID4VP 1.0 / HAIP verifier with the declared-attribute list (CIR (EU) 2025/848) enforced at construction.",
	"license": "Apache-2.0",
	"type": "module",
	"main": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=18"
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"upact",
		"identity-port",
		"eudi",
		"eudi-wallet",
		"openid4vp",
		"sd-jwt-vc",
		"haip",
		"relying-party",
		"anti-corruption-layer",
		"privacy-by-design",
		"minimum-disclosure"
	],
	"author": "Theodore Evans",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/prefig/upact-eudi.git"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "ERICA_AVAILABLE=1 vitest run --config vitest.integration.config.ts",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build && npm test"
	},
	"peerDependencies": {
		"@openid4vc/openid4vp": "^0.5.4",
		"@prefig/upact": "^0.1.0",
		"@sd-jwt/sd-jwt-vc": "^0.20.0"
	},
	"devDependencies": {
		"@openid4vc/openid4vp": "^0.5.4",
		"@prefig/upact": "^0.1.1",
		"@sd-jwt/sd-jwt-vc": "^0.20.0",
		"@types/node": "^22.20.1",
		"typescript": "^5.9.3",
		"vitest": "^3.2.7"
	}
}
